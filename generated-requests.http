# HomeEnergyRegistryApp - manual requests for the IntelliJ HTTP client.
#
# Flow: 1) get a token (Auth section) - the response handler stores access_token / refresh_token,
#       2) call the API; ids returned by "create" requests are stored and reused by the next requests.
# Secrets (password, one-time code, OTP) are placeholders - fill them locally, never commit real values.

@keycloak = http://localhost:9090
@realm = homeenergyregistry-realm
@client_id = homeenergyregistry-app
@redirect_uri = http://localhost:8081/callback
@app = http://localhost:8080
@api = {{app}}/api/v1

@username = testuser
@password = <password>
@code = <one-time code from the login redirect>
@otp = <current OTP>

# Existing master data to start from (replace with ids from your database)
@homeAdministrativeAreaId = 00000000-0000-0000-0000-000000000000
@energyCarrierId = 00000000-0000-0000-0000-000000000000
@categoryId = 00000000-0000-0000-0000-000000000000


######################################################################
# Auth (Keycloak)
######################################################################

### Login link - open in a browser, copy the "code" parameter from the redirect into @code
GET {{keycloak}}/realms/{{realm}}/protocol/openid-connect/auth?client_id={{client_id}}&response_type=code&scope=openid%20profile%20email&redirect_uri={{redirect_uri}}&prompt=login

### Token - authorization code (with MFA done in the browser)
POST {{keycloak}}/realms/{{realm}}/protocol/openid-connect/token
Content-Type: application/x-www-form-urlencoded

grant_type=authorization_code&client_id={{client_id}}&redirect_uri={{redirect_uri}}&code={{code}}

> {%
    client.global.set("access_token", response.body.access_token);
    client.global.set("refresh_token", response.body.refresh_token);
%}

### Token - direct grant (username + password + OTP)
POST {{keycloak}}/realms/{{realm}}/protocol/openid-connect/token
Content-Type: application/x-www-form-urlencoded

grant_type=password&client_id={{client_id}}&username={{username}}&password={{password}}&totp={{otp}}

> {%
    client.global.set("access_token", response.body.access_token);
    client.global.set("refresh_token", response.body.refresh_token);
%}

### Token - refresh
POST {{keycloak}}/realms/{{realm}}/protocol/openid-connect/token
Content-Type: application/x-www-form-urlencoded

grant_type=refresh_token&client_id={{client_id}}&refresh_token={{refresh_token}}

> {%
    client.global.set("access_token", response.body.access_token);
    client.global.set("refresh_token", response.body.refresh_token);
%}

### Logout - ends the Keycloak session of the stored refresh token
POST {{keycloak}}/realms/{{realm}}/protocol/openid-connect/logout
Content-Type: application/x-www-form-urlencoded

client_id={{client_id}}&refresh_token={{refresh_token}}


######################################################################
# Home administrative areas
######################################################################

### List home administrative areas in scope
GET {{api}}/home-administrative-areas
Authorization: Bearer {{access_token}}

### Get home administrative area by id
GET {{api}}/home-administrative-areas/{{homeAdministrativeAreaId}}
Authorization: Bearer {{access_token}}


######################################################################
# Yard public areas
######################################################################

### List yard public areas in scope
GET {{api}}/yard-public-areas
Authorization: Bearer {{access_token}}

### Create yard public area (ADMIN)
POST {{api}}/yard-public-areas
Authorization: Bearer {{access_token}}
Content-Type: application/json

{
  "name": "Municipal swimming pool",
  "homeAdministrativeAreaId": "{{homeAdministrativeAreaId}}"
}

> {% client.global.set("yardPublicAreaId", response.body.id); %}

### Get yard public area by id
GET {{api}}/yard-public-areas/{{yardPublicAreaId}}
Authorization: Bearer {{access_token}}

### Patch yard public area (ADMIN)
PATCH {{api}}/yard-public-areas/{{yardPublicAreaId}}
Authorization: Bearer {{access_token}}
Content-Type: application/json

{
  "name": "Municipal swimming pool (renamed)"
}

### Delete yard public area (ADMIN)
DELETE {{api}}/yard-public-areas/{{yardPublicAreaId}}
Authorization: Bearer {{access_token}}


######################################################################
# Users (ADMIN)
######################################################################

### List users in scope
GET {{api}}/users
Authorization: Bearer {{access_token}}

### Create user with an ESR editor role on the yard public area
POST {{api}}/users
Authorization: Bearer {{access_token}}
Content-Type: application/json

{
  "firstName": "Test",
  "lastName": "User",
  "email": "test.user@example.com",
  "yardPublicAreaId": "{{yardPublicAreaId}}",
  "roles": [
    { "role": "ESR_EDITOR", "yardPublicAreaId": "{{yardPublicAreaId}}" }
  ]
}

> {% client.global.set("userId", response.body.id); %}

### Get user by id
GET {{api}}/users/{{userId}}
Authorization: Bearer {{access_token}}

### Patch user - roles: absent = unchanged, [] = remove all in scope, list = exactly these
PATCH {{api}}/users/{{userId}}
Authorization: Bearer {{access_token}}
Content-Type: application/json

{
  "lastName": "User-Updated",
  "roles": [
    { "role": "ESR_VIEWER", "yardPublicAreaId": "{{yardPublicAreaId}}" }
  ]
}

### Deactivate user (409 LAST_ADMIN_CONFIRMATION_REQUIRED -> repeat with confirmed=true)
DELETE {{api}}/users/{{userId}}?confirmed=false
Authorization: Bearer {{access_token}}


######################################################################
# ESR - Energy Supply Register
######################################################################

### Building consumption categories (master data)
GET {{api}}/esr/buildings/categories
Authorization: Bearer {{access_token}}

### Energy carrier units (master data)
GET {{api}}/esr/energy-carriers/units
Authorization: Bearer {{access_token}}

### List ESR building entries of the yard public area
GET {{api}}/yard-public-areas/{{yardPublicAreaId}}/esr/buildings
Authorization: Bearer {{access_token}}

### Create building consumption (not heat-only)
POST {{api}}/yard-public-areas/{{yardPublicAreaId}}/esr/buildings
Authorization: Bearer {{access_token}}
Content-Type: application/json

{
  "objectType": "BuildingConsumption",
  "carrier": "{{energyCarrierId}}",
  "category": "{{categoryId}}",
  "quantity": "1250.5",
  "start": "2026-01-01",
  "end": "2026-12-31"
}

> {% client.global.set("esrEntryId", response.body.id); %}

### Create heat building consumption (heat-only, weather-adjusted flag required)
POST {{api}}/yard-public-areas/{{yardPublicAreaId}}/esr/buildings
Authorization: Bearer {{access_token}}
Content-Type: application/json

{
  "objectType": "HeatBuildingConsumption",
  "carrier": "{{energyCarrierId}}",
  "category": "{{categoryId}}",
  "quantity": "8400",
  "start": "2026-01-01",
  "end": "2026-12-31",
  "isWeatherAdjusted": true
}

### Replace ESR entry (the type cannot change)
PUT {{api}}/yard-public-areas/{{yardPublicAreaId}}/esr/buildings/{{esrEntryId}}
Authorization: Bearer {{access_token}}
Content-Type: application/json

{
  "objectType": "BuildingConsumption",
  "carrier": "{{energyCarrierId}}",
  "category": "{{categoryId}}",
  "quantity": "1300",
  "start": "2026-01-01",
  "end": "2026-12-31"
}

### Delete ESR entry
DELETE {{api}}/yard-public-areas/{{yardPublicAreaId}}/esr/buildings/{{esrEntryId}}
Authorization: Bearer {{access_token}}


######################################################################
# Energy CSV import (outside the OpenAPI contract)
######################################################################

### Upload meter readings CSV
POST {{app}}/energy/upload
Authorization: Bearer {{access_token}}
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="files"; filename="meter-a.csv"
Content-Type: text/csv

< ./src/test/resources/testfiles/meter-a.csv
--boundary--


######################################################################
# Operations
######################################################################

### Health
GET {{app}}/actuator/health
